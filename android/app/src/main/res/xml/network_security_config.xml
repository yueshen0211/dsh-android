<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is allowed for exactly one authority: the on-device engine, which
  binds 127.0.0.1. Everything else keeps the platform default (cleartext
  refused), so a model-authored link can never pull content over plain HTTP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
